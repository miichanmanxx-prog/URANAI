rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    //  ヘルパー関数
    // ================================================================

    // Firebase Authentication でログイン済みか
    function isAuthenticated() {
      return request.auth != null;
    }

    // 自分自身のドキュメントか
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // カスタムクレームで role を確認
    function hasRole(role) {
      return isAuthenticated()
        && request.auth.token.get('role', '') == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isShop(shopId) {
      return isAuthenticated()
        && request.auth.token.get('shopId', '') == shopId;
    }

    // 書き込み時に不要なフィールドが混入していないか検証
    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ================================================================
    //  ユーザー
    //  /users/{uid}
    // ================================================================
    match /users/{uid} {
      // 本人のみ読み取り可能（管理者も可）
      allow read: if isOwner(uid) || isAdmin();

      // 本人のみ作成可能（初回登録時）
      // uid・email・createdAt 以外の管理フィールドは書き込み不可
      allow create: if isOwner(uid)
        && onlyFields(['name', 'email', 'birthDate', 'gender',
                       'memberSince', 'plan', 'createdAt']);

      // 本人は安全なフィールドのみ更新可能
      // plan・email・role などの特権フィールドは変更不可
      allow update: if isOwner(uid)
        && onlyFields(['name', 'birthDate', 'gender', 'updatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'plan', 'role', 'createdAt', 'uid']);

      // 削除は管理者のみ
      allow delete: if isAdmin();

      // ────────────────────────────────────────────────
      //  月相プロフィール（バックエンド生成・読み取り専用）
      //  /users/{uid}/moonProfile/{doc}
      // ────────────────────────────────────────────────
      match /moonProfile/{doc} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isAdmin(); // バックエンドのみ書き込み
      }

      // ────────────────────────────────────────────────
      //  鑑定履歴
      //  /users/{uid}/readings/{readingId}
      // ────────────────────────────────────────────────
      match /readings/{readingId} {
        allow read:   if isOwner(uid) || isAdmin();
        // 鑑定結果はバックエンド（Cloud Functions）が書き込む
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ================================================================
    //  店舗
    //  /shops/{shopId}
    // ================================================================
    match /shops/{shopId} {
      // 該当店舗のオーナーと管理者が読み取り可能
      allow read: if isShop(shopId) || isAdmin();

      // 作成・削除は管理者のみ
      allow create: if isAdmin();
      allow delete: if isAdmin();

      // 更新：店舗は限定フィールドのみ変更可（管理者は全フィールド）
      allow update: if isAdmin()
        || (isShop(shopId)
            && onlyFields(['contactEmail', 'contactPhone', 'updatedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['sales', 'payout', 'status', 'bank',
                         'account', 'shopId', 'createdAt']));

      // ────────────────────────────────────────────────
      //  取引履歴
      //  /shops/{shopId}/transactions/{txId}
      // ────────────────────────────────────────────────
      match /transactions/{txId} {
        allow read:   if isShop(shopId) || isAdmin();
        // 取引はバックエンドのみ作成
        allow write:  if isAdmin();
      }

      // ────────────────────────────────────────────────
      //  日別売上集計（バックエンド集計結果）
      //  /shops/{shopId}/dailySales/{dateId}
      // ────────────────────────────────────────────────
      match /dailySales/{dateId} {
        allow read:  if isShop(shopId) || isAdmin();
        allow write: if isAdmin();
      }

      // ────────────────────────────────────────────────
      //  振込記録
      //  /shops/{shopId}/payouts/{payoutId}
      // ────────────────────────────────────────────────
      match /payouts/{payoutId} {
        allow read:  if isShop(shopId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ================================================================
    //  AI鑑定師キャラクター
    //  /characters/{charId}
    // ================================================================
    match /characters/{charId} {
      // 認証済みユーザー（一般・店舗）は読み取り可能
      // ただしAIプロンプトフィールドは管理者のみ
      allow read: if isAuthenticated()
        && (isAdmin()
            || !('prompt' in resource.data)
            || request.resource == null);  // 一般ユーザーはpromptフィールドを除いて取得

      // 管理者のみ変更可能
      allow write: if isAdmin();
    }

    // ================================================================
    //  占いメニュー
    //  /menus/{menuId}
    // ================================================================
    match /menus/{menuId} {
      // 有効なメニューは認証済みユーザーが読み取り可能
      allow read: if isAuthenticated()
        && (resource.data.status == true || isAdmin() || isShop('*'));

      // 管理者のみ変更可能
      allow write: if isAdmin();
    }

    // ================================================================
    //  決済セッション（Stripe連携）
    //  /checkoutSessions/{sessionId}
    // ================================================================
    match /checkoutSessions/{sessionId} {
      // 本人と管理者のみ閲覧
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.uid || isAdmin());

      // 作成はバックエンドのみ（クライアントから直接作成不可）
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ================================================================
    //  その他すべてのドキュメントは拒否（デフォルト・フェイルセーフ）
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
