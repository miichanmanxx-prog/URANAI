rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    //  ヘルパー関数
    // ================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isAuthenticated()
        && request.auth.token.get('role', '') == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isShop(shopId) {
      return isAuthenticated()
        && request.auth.token.get('shopId', '') == shopId;
    }

    function isStore(storeId) {
      return isAuthenticated()
        && request.auth.token.get('storeId', '') == storeId;
    }

    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ================================================================
    //  ユーザー
    //  /users/{uid}
    // ================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && onlyFields(['createdAt', 'lastLogin']);

      allow update: if isOwner(uid)
        && onlyFields(['lastLogin', 'updatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdAt', 'uid']);

      allow delete: if isAdmin();
    }

    // ================================================================
    //  店舗情報
    //  /stores/{storeId}
    // ================================================================
    match /stores/{storeId} {
      allow read: if isStore(storeId) || isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isStore(storeId)
            && onlyFields(['email', 'updatedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['createdAt', 'isActive', 'ownerName']));
    }

    // ================================================================
    //  QRリンク
    //  /qrLinks/{token}
    // ================================================================
    match /qrLinks/{token} {
      // 未認証ユーザーもトークン検索可能（占いページからの参照用）
      allow read: if true;
      // 管理者または自店舗のみ発行可能
      allow create: if isAdmin()
        || (isStore(request.resource.data.storeId)
            && onlyFields(['token', 'storeId', 'createdAt', 'isActive']));
      allow update: if isAdmin()
        || isStore(resource.data.storeId);
      allow delete: if isAdmin();
    }

    // ================================================================
    //  占いセッション
    //  /fortuneSessions/{sessionId}
    // ================================================================
    match /fortuneSessions/{sessionId} {
      // 未認証ユーザーでも作成可能（占いページから記録）
      allow create: if onlyFields(['userId', 'source', 'storeId', 'selectedFortune', 'createdAt']);
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ================================================================
    //  決済履歴
    //  /payments/{paymentId}
    // ================================================================
    match /payments/{paymentId} {
      // 管理者は全件閲覧、店舗は自店舗分のみ
      allow read: if isAdmin()
        || (isAuthenticated() && isStore(resource.data.storeId));
      // 書き込みはバックエンド（Webhook）のみ
      allow write: if isAdmin();
    }

    // ================================================================
    //  既存コレクション（後方互換）
    // ================================================================
    match /shops/{shopId} {
      allow read: if isShop(shopId) || isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isShop(shopId)
            && onlyFields(['contactEmail', 'contactPhone', 'updatedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['sales', 'payout', 'status', 'bank',
                         'account', 'shopId', 'createdAt']));

      match /transactions/{txId} {
        allow read: if isShop(shopId) || isAdmin();
        allow write: if isAdmin();
      }
      match /dailySales/{dateId} {
        allow read: if isShop(shopId) || isAdmin();
        allow write: if isAdmin();
      }
      match /payouts/{payoutId} {
        allow read: if isShop(shopId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /checkoutSessions/{sessionId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ================================================================
    //  デフォルト拒否
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
